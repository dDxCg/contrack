JWT_SECRET=change-me-in-every-environment

JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=43200

BCRYPT_ROUNDS=10

DB_HOST=localhost
DB_PORT=5432
DB_NAME=contrack
DB_USER=contrack
DB_PASSWORD=contrack
DB_SSL=false
DB_POOL_MAX=10

REDIS_LOCK_URL=

# Object storage (S3 API). All three of S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# are required together: unset → field photo uploads fail storage.unavailable (503);
# set → POST /field/uploads signs real upload URLs, no code change needed.
# Works with AWS S3 and any S3-compatible endpoint (MinIO, R2, B2).
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave blank for AWS; set for S3-compatible storage, e.g. http://minio:9000
S3_ENDPOINT=
S3_REGION=ap-southeast-1
# true for MinIO/path-style endpoints, false for AWS virtual-hosted buckets
S3_FORCE_PATH_STYLE=false
# How long a signed upload URL stays valid, in seconds
S3_UPLOAD_URL_TTL_SECONDS=300

CORS_ORIGINS=
